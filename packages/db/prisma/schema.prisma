// Denobelpro Marketplace — data model
// PostgreSQL only. UUID primary keys, UTC timestamps, soft deletes where useful.
// Status-like values are strings because admins manage their labels and transitions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  role               String    @default("client") @db.VarChar(32)
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash")
  name               String    @db.VarChar(160)
  avatarUrl          String?   @map("avatar_url") @db.Text
  phone              String?   @db.VarChar(40)
  status             String    @default("pending") @db.VarChar(32)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  twoFactorSecret    String?   @map("two_factor_secret") @db.Text
  twoFactorEnabled   Boolean   @default(false) @map("two_factor_enabled")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  locale             String    @default("en") @db.VarChar(10)
  timezone           String    @default("Africa/Lagos") @db.VarChar(60)
  suspendedReason    String?   @map("suspended_reason") @db.Text
  extraFields        Json?     @map("extra_fields")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  staffProfile        StaffProfile?
  clientProfile       ClientProfile?
  sessions            Session[]
  passwordResets      PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  staffRelationships  Relationship[]           @relation("StaffRelationships")
  clientRelationships Relationship[]           @relation("ClientRelationships")
  invitationsSent     Invitation[]             @relation("InvitationsSent")
  gigs                Gig[]                    @relation("StaffGigs")
  messages            Message[]                @relation("MessageSender")
  offersCreated       Offer[]                  @relation("OfferCreator")
  ordersAsStaff       Order[]                  @relation("OrderStaff")
  ordersAsClient      Order[]                  @relation("OrderClient")
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  auditLogs           AuditLog[]               @relation("AuditActor")

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

model StaffProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  title             String?   @db.VarChar(120)
  department        String?   @db.VarChar(120)
  bio               String?   @db.Text
  skills            String[]  @default([])
  languages         String[]  @default([])
  yearsExperience   Int?      @map("years_experience")
  responseTimeHours Int?      @map("response_time_hours")
  workingHours      Json?     @map("working_hours")
  timezone          String?   @db.VarChar(60)
  availability      String    @default("available") @db.VarChar(32)
  returnDate        DateTime? @map("return_date")
  portfolioLinks    Json?     @map("portfolio_links")
  certificates      Json?     @map("certificates")
  inviteCode        String    @unique @map("invite_code") @db.VarChar(40)
  customCommission  Decimal?  @map("custom_commission") @db.Decimal(5, 2)
  approvalStatus    String    @default("pending") @map("approval_status") @db.VarChar(32)
  lockedFields      String[]  @default([]) @map("locked_fields")
  extraFields       Json?     @map("extra_fields")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
  @@map("staff_profiles")
}

model ClientProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  company     String?   @db.VarChar(160)
  country     String?   @db.VarChar(80)
  extraFields Json?     @map("extra_fields")
  blockedAt   DateTime? @map("blocked_at")
  blockReason String?   @map("block_reason") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Relationship {
  id                String        @id @default(uuid()) @db.Uuid
  staffId           String        @map("staff_id") @db.Uuid
  clientId          String        @map("client_id") @db.Uuid
  status            String        @default("active") @db.VarChar(32)
  invitedVia        String?       @map("invited_via") @db.VarChar(32)
  sourceInvitation  String?       @map("source_invitation") @db.Uuid
  lastInteractionAt DateTime?     @map("last_interaction_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  staff             User          @relation("StaffRelationships", fields: [staffId], references: [id], onDelete: Restrict)
  client            User          @relation("ClientRelationships", fields: [clientId], references: [id], onDelete: Restrict)
  conversation      Conversation?
  offers            Offer[]
  orders            Order[]

  @@unique([staffId, clientId])
  @@index([clientId, status])
  @@index([staffId, status])
  @@map("relationships")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  staffId        String    @map("staff_id") @db.Uuid
  email          String    @db.VarChar(254)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  message        String?   @db.Text
  status         String    @default("sent") @db.VarChar(32)
  expiresAt      DateTime  @map("expires_at")
  openedAt       DateTime? @map("opened_at")
  acceptedAt     DateTime? @map("accepted_at")
  relationshipId String?   @map("relationship_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  staff          User      @relation("InvitationsSent", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

model Gig {
  id              String           @id @default(uuid()) @db.Uuid
  staffId         String           @map("staff_id") @db.Uuid
  categoryId      String?          @map("category_id") @db.Uuid
  subcategoryId   String?          @map("subcategory_id") @db.Uuid
  title           String           @db.VarChar(200)
  description     String           @db.Text
  status          String           @default("draft") @db.VarChar(32)
  rejectionReason String?          @map("rejection_reason") @db.Text
  featured        Boolean          @default(false)
  searchTags      String[]         @default([]) @map("search_tags")
  whatYouGet      Json?            @map("what_you_get")
  extraFields     Json?            @map("extra_fields")
  publishedAt     DateTime?        @map("published_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  staff           User             @relation("StaffGigs", fields: [staffId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packages        GigPackage[]
  addons          GigAddon[]
  media           GigMedia[]
  faqs            GigFaq[]
  requirements    GigRequirement[]
  orders          Order[]

  // The "one gig per staff member" rule lives in marketplace.gigsPerStaff, so
  // the database does not hard-code a unique constraint that admins cannot lift.
  @@index([staffId, status])
  @@index([status, featured])
  @@index([categoryId])
  @@map("gigs")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.Text
  parentId    String?   @map("parent_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  gigs        Gig[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model GigPackage {
  id           String   @id @default(uuid()) @db.Uuid
  gigId        String   @map("gig_id") @db.Uuid
  key          String   @db.VarChar(40)
  name         String   @db.VarChar(120)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(14, 2)
  deliveryDays Int      @map("delivery_days")
  revisions    Int      @default(1)
  features     String[] @default([])
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  gig          Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([gigId, key])
  @@map("gig_packages")
}

model GigAddon {
  id          String   @id @default(uuid()) @db.Uuid
  gigId       String   @map("gig_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.Text
  price       Decimal  @db.Decimal(14, 2)
  extraDays   Int      @default(0) @map("extra_days")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId])
  @@map("gig_addons")
}

model GigMedia {
  id           String   @id @default(uuid()) @db.Uuid
  gigId        String   @map("gig_id") @db.Uuid
  type         String   @db.VarChar(24)
  url          String   @db.Text
  thumbnailUrl String?  @map("thumbnail_url") @db.Text
  altText      String?  @map("alt_text") @db.VarChar(300)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  gig          Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId, sortOrder])
  @@map("gig_media")
}

model GigFaq {
  id        String   @id @default(uuid()) @db.Uuid
  gigId     String   @map("gig_id") @db.Uuid
  question  String   @db.VarChar(300)
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId, sortOrder])
  @@map("gig_faqs")
}

model GigRequirement {
  id        String   @id @default(uuid()) @db.Uuid
  gigId     String   @map("gig_id") @db.Uuid
  label     String   @db.VarChar(300)
  type      String   @db.VarChar(32)
  options   Json?
  helpText  String?  @map("help_text") @db.Text
  required  Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId, sortOrder])
  @@map("gig_requirements")
}

model Conversation {
  id             String       @id @default(uuid()) @db.Uuid
  relationshipId String       @unique @map("relationship_id") @db.Uuid
  locked         Boolean      @default(false)
  lockedReason   String?      @map("locked_reason") @db.Text
  lastMessageAt  DateTime?    @map("last_message_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  type           String       @default("text") @db.VarChar(24)
  body           String?      @db.Text
  attachments    Json?
  replyToId      String?      @map("reply_to_id") @db.Uuid
  editedAt       DateTime?    @map("edited_at")
  deletedAt      DateTime?    @map("deleted_at")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model QuickReply {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  title     String   @db.VarChar(120)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([staffId])
  @@map("quick_replies")
}

model Offer {
  id             String       @id @default(uuid()) @db.Uuid
  relationshipId String       @map("relationship_id") @db.Uuid
  gigId          String?      @map("gig_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  version        Int          @default(1)
  parentOfferId  String?      @map("parent_offer_id") @db.Uuid
  title          String       @db.VarChar(200)
  description    String?      @db.Text
  price          Decimal      @db.Decimal(14, 2)
  currency       String       @default("NGN") @db.VarChar(3)
  deliveryDays   Int          @map("delivery_days")
  revisions      Int          @default(1)
  milestones     Json?
  addons         Json?
  requirements   Json?
  status         String       @default("sent") @db.VarChar(32)
  expiresAt      DateTime?    @map("expires_at")
  sentAt         DateTime?    @default(now()) @map("sent_at")
  viewedAt       DateTime?    @map("viewed_at")
  acceptedAt     DateTime?    @map("accepted_at")
  declinedAt     DateTime?    @map("declined_at")
  declineReason  String?      @map("decline_reason") @db.Text
  approvalStatus String       @default("not_required") @map("approval_status") @db.VarChar(32)
  approvedById   String?      @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?    @map("approved_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("OfferCreator", fields: [createdById], references: [id], onDelete: Restrict)
  order          Order?

  @@index([relationshipId, status])
  @@index([status, expiresAt])
  @@map("offers")
}

model Order {
  id                      String           @id @default(uuid()) @db.Uuid
  number                  String           @unique @db.VarChar(40)
  relationshipId          String           @map("relationship_id") @db.Uuid
  offerId                 String?          @unique @map("offer_id") @db.Uuid
  gigId                   String?          @map("gig_id") @db.Uuid
  staffId                 String           @map("staff_id") @db.Uuid
  clientId                String           @map("client_id") @db.Uuid
  status                  String           @default("awaiting_payment") @db.VarChar(40)
  price                   Decimal          @db.Decimal(14, 2)
  fee                     Decimal          @default(0) @db.Decimal(14, 2)
  tax                     Decimal          @default(0) @db.Decimal(14, 2)
  total                   Decimal          @db.Decimal(14, 2)
  currency                String           @default("NGN") @db.VarChar(3)
  dueAt                   DateTime?        @map("due_at")
  requirements            Json?
  requirementsSubmittedAt DateTime?        @map("requirements_submitted_at")
  deliveredAt             DateTime?        @map("delivered_at")
  completedAt             DateTime?        @map("completed_at")
  autoCompleteAt          DateTime?        @map("auto_complete_at")
  reviewedAt              DateTime?        @map("reviewed_at")
  cancelledAt             DateTime?        @map("cancelled_at")
  cancellationReason      String?          @map("cancellation_reason") @db.Text
  cancelledById           String?          @map("cancelled_by_id") @db.Uuid
  createdById             String?          @map("created_by_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  relationship            Relationship     @relation(fields: [relationshipId], references: [id], onDelete: Restrict)
  offer                   Offer?           @relation(fields: [offerId], references: [id], onDelete: SetNull)
  gig                     Gig?             @relation(fields: [gigId], references: [id], onDelete: SetNull)
  staff                   User             @relation("OrderStaff", fields: [staffId], references: [id], onDelete: Restrict)
  client                  User             @relation("OrderClient", fields: [clientId], references: [id], onDelete: Restrict)
  events                  OrderEvent[]
  deliveries              OrderDelivery[]
  revisions               OrderRevision[]
  notes                   OrderNote[]
  extensions              OrderExtension[]
  payments                Payment[]
  refunds                 Refund[]
  invoices                Invoice[]
  disputes                Dispute[]
  review                  Review?

  @@index([staffId, status])
  @@index([clientId, status])
  @@index([status, dueAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  type      String   @db.VarChar(60)
  actorId   String?  @map("actor_id") @db.Uuid
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  message        String?  @db.Text
  attachments    Json?
  revisionNumber Int      @default(1) @map("revision_number")
  createdAt      DateTime @default(now()) @map("created_at")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_deliveries")
}

model OrderRevision {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  requestedById String    @map("requested_by_id") @db.Uuid
  notes         String?   @db.Text
  attachments   Json?
  status        String    @default("requested") @db.VarChar(32)
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_revisions")
}

model OrderNote {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  internal  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model OrderExtension {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  requestedById String    @map("requested_by_id") @db.Uuid
  proposedDueAt DateTime  @map("proposed_due_at")
  reason        String    @db.Text
  status        String    @default("pending") @db.VarChar(32)
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("order_extensions")
}

model Payment {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  provider    String    @db.VarChar(40)
  providerRef String?   @map("provider_ref") @db.VarChar(200)
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("NGN") @db.VarChar(3)
  status      String    @default("initiated") @db.VarChar(32)
  rawPayload  Json?     @map("raw_payload")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([orderId, status])
  @@map("payments")
}

model LedgerEntry {
  id           String   @id @default(uuid()) @db.Uuid
  account      String   @db.VarChar(80)
  orderId      String?  @map("order_id") @db.Uuid
  paymentId    String?  @map("payment_id") @db.Uuid
  refundId     String?  @map("refund_id") @db.Uuid
  payoutId     String?  @map("payout_id") @db.Uuid
  type         String   @db.VarChar(50)
  debit        Decimal  @default(0) @db.Decimal(14, 2)
  credit       Decimal  @default(0) @db.Decimal(14, 2)
  currency     String   @default("NGN") @db.VarChar(3)
  balanceAfter Decimal? @map("balance_after") @db.Decimal(16, 2)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([account, createdAt])
  @@index([orderId])
  @@index([type])
  @@map("ledger_entries")
}

model Payout {
  id            String    @id @default(uuid()) @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("NGN") @db.VarChar(3)
  status        String    @default("pending") @db.VarChar(32)
  reference     String?   @db.VarChar(120)
  periodStart   DateTime? @map("period_start")
  periodEnd     DateTime? @map("period_end")
  processedById String?   @map("processed_by_id") @db.Uuid
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([staffId, status])
  @@map("payouts")
}

model Refund {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("NGN") @db.VarChar(3)
  reason        String    @db.Text
  status        String    @default("pending") @db.VarChar(32)
  providerRef   String?   @map("provider_ref") @db.VarChar(200)
  processedById String?   @map("processed_by_id") @db.Uuid
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@map("refunds")
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  number    String   @unique @db.VarChar(40)
  orderId   String   @map("order_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @default("invoice") @db.VarChar(20)
  amount    Decimal  @db.Decimal(14, 2)
  tax       Decimal  @default(0) @db.Decimal(14, 2)
  total     Decimal  @db.Decimal(14, 2)
  currency  String   @default("NGN") @db.VarChar(3)
  pdfUrl    String?  @map("pdf_url") @db.Text
  issuedAt  DateTime @default(now()) @map("issued_at")
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt])
  @@map("invoices")
}

model Sequence {
