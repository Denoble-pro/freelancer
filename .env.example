# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://dlp:dlp_dev_password@localhost:5432/denobelpro?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=denobelpro-marketplace
ACCESS_COOKIE_NAME=dlp_access
REFRESH_COOKIE_NAME=dlp_refresh
COOKIE_DOMAIN=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Seed / demo accounts ---
SEED_ADMIN_EMAIL=admin@denobelpro.local
SEED_ADMIN_NAME=Denobelpro Management
SEED_ADMIN_PASSWORD=ChangeMe-Immediately-2026!
SEED_DEMO_PASSWORD=Denobelpro!2026

# --- Infrastructure (Phase 1 optional; used by later phases) ---
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=denobelpro
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Denobelpro <hello@denobelpro.local>"
