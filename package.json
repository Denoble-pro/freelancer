{
  "name": "denobelpro-freelancers",
  "version": "0.1.0",
  "private": true,
  "description": "Denobelpro's private, invitation-only freelance marketplace for staff and their clients.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @dlp/api",
    "dev:web": "npm run dev -w @dlp/web",
    "build": "npm run build -w @dlp/web",
    "typecheck": "npm run typecheck -w @dlp/shared && npm run typecheck -w @dlp/db && npm run typecheck -w @dlp/api && npm run typecheck -w @dlp/web",
    "test": "npm run test -w @dlp/api",
    "test:watch": "npm run test:watch -w @dlp/api",
    "lint": "npm run typecheck && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:bootstrap": "tsx packages/db/prisma/bootstrap.ts",
    "db:seed": "prisma db seed --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema packages/db/prisma/schema.prisma --force"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
